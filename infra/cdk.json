{
  "app": "python3 app.py",
  "watch": {
    "include": ["**"],
    "exclude": [
      "README.md",
      "cdk*.json",
      "requirements*.txt",
      "source.bat",
      "**/__pycache__",
      ".venv"
    ]
  },
  "context": {
    "@aws-cdk/core:bootstrapQualifier": "sde",
    "@aws-cdk/aws-s3:createDefaultLoggingPolicy": true
  }
}
